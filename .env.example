# Copy to .env and fill in keys only if you enable LIVE trading.
# Paper mode never needs keys.

BOT_MODE=paper
BOT_HOST=0.0.0.0
BOT_PORT=8000
STARTING_EQUITY=10000

# Optional live trading — leave blank to stay in paper mode
BINANCE_API_KEY=
BINANCE_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=
COINBASE_API_KEY=
COINBASE_API_SECRET=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=
